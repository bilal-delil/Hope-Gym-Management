NODE_ENV=development
PORT=4000

# PostgreSQL (either name works)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hope_gym
# DB_URL=postgres://postgres:postgres@localhost:5432/hope_gym

# JWT (issued after Google sign-in)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Google OAuth client IDs (comma-separated: admin web + PWA)
GOOGLE_CLIENT_IDS=your-admin-google-client-id.apps.googleusercontent.com,your-pwa-google-client-id.apps.googleusercontent.com

# Admin allowlist (comma-separated). ONLY these Google emails can sign in to admin.
# Example with multiple admins:
# ADMIN_GOOGLE_EMAILS=owner@gmail.com,manager@gmail.com,staff@gmail.com
ADMIN_GOOGLE_EMAILS=you@gmail.com

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional seed helpers (SEED_ADMIN_EMAIL is also merged into the allowlist)
SEED_ADMIN_EMAIL=you@gmail.com
SEED_ADMIN_NAME=Hope Admin
