{
  "name": "nodejs-server",
  "version": "1.0.0",
  "description": "Hope Gym Management API server",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node -r ./scripts/load-env.js ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "migrate:down": "node -r ./scripts/load-env.js ./node_modules/node-pg-migrate/bin/node-pg-migrate.js down",
    "migrate:create": "node -r ./scripts/load-env.js ./node_modules/node-pg-migrate/bin/node-pg-migrate.js create",
    "seed": "node -r ./scripts/load-env.js src/db/seed.js"
  },
  "keywords": [
    "gym",
    "management",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.5",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "google-auth-library": "^11.3.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.4.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "node-pg-migrate": "^8.0.3",
    "nodemon": "^3.1.10"
  }
}
